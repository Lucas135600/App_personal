# Produção. Em desenvolvimento, deixe tudo vazio: o app sobe um Postgres
# embutido (PGlite) em data/pg e popula com os dados de demonstração.

# Supabase → Project Settings → Database → Connection string (URI)
# Use a porta 6543 (pooler) quando publicar em serverless.
DATABASE_URL=

# Assina o cookie de sessão. OBRIGATÓRIA em produção.
# Gere uma com:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LB_SESSION_SECRET=

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PHOTOS_BUCKET=fotos-evolucao

# Chave do cron que pergunta ao personal se a aula aconteceu.
# A Vercel manda em "Authorization: Bearer <chave>". Sem ela a rota não roda.
# Gere com:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=
